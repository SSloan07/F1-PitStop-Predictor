P1 [id="node-P1", label="P1 · Candidata RNN16 pareada\nCorrida nueva desde cero\nCompletada; pareja controlada\nRNN 16 · T4 / CUDA\nÉpoca 14 · umbral 0,10\nF1 0,2684 | F2 0,4379\nP 16,31% | R 75,64%\nEventos 666/824", fillcolor="#ede9fe", style="rounded,filled"];
